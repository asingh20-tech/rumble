# Copy to server/.env (loaded automatically by `npm run dev` / `npm start`).
PORT=3001
# Comma-separated list of allowed frontend origins (production: your Vercel URL).
CLIENT_ORIGIN=http://localhost:5173
# Player limits. MAX_PLAYERS is capped at 8 (one neon color per player).
MIN_PLAYERS=4
MAX_PLAYERS=8
# Used instead of MIN_PLAYERS when NODE_ENV=development (`npm run dev` sets this).
DEV_MIN_PLAYERS=1
