# Copy to client/.env.local. Both are optional for local dev + cloudflared tunnel.
# Backend URL. Leave empty to use the same origin (Vite proxies /socket.io to :3001).
# Production example: https://rumble-server.onrender.com
VITE_SERVER_URL=
# Public URL encoded in the join QR code. Leave empty to use window.location.origin.
# Production example: https://rumble.vercel.app
VITE_PUBLIC_URL=
